						<input type="checkbox" name="exclude-rarity" value="{{this}}" />
						<span>{{this}}</span>
					</label>
				{{/each}}
			</div>
		</div>

		<!-- Exclude Type -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.EXCLUDETYPE"}}</h5>
			<div id="exclude-type" class="criteria-options">
				{{#each criteria.type}}
					<label class="criteria-option">
						<input type="checkbox" name="exclude-type" value="{{this}}" />
						<span>{{this}}</span>
					</label>
				{{/each}}
			</div>
		</div>

		<!-- Exclude Category -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.EXCLUDECATEGORY"}}</h5>
			<div id="exclude-category" class="criteria-options">
				{{#each criteria.category}}
					<label class="criteria-option">
						<input type="checkbox" name="exclude-category" value="{{this}}" />
						<span>{{this}}</span>
					</label>
				{{/each}}
			</div>
		</div>

		<!-- Exclude Group -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.EXCLUDEGROUP"}}</h5>
			<div id="exclude-group" class="criteria-options">
				{{#each criteria.group}}
					<label class="criteria-option">
						<input type="checkbox" name="exclude-group" value="{{this}}" />
						<span>{{this}}</span>
					</label>
				{{/each}}
			</div>
		</div>

		<!-- Exclude Level -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.EXCLUDELEVEL"}}</h5>
			<div id="exclude-level" class="criteria-options">
				{{#each criteria.level}}
					<label class="criteria-option">
						<input type="checkbox" name="exclude-level" value="{{this}}" />
						<span>{{this}}</span>
					</label>
				{{/each}}
			</div>
		</div>

		<!-- Exclude Range -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.EXCLUDERANGE"}}</h5>
			<div id="exclude-range" class="criteria-options">
				{{#each criteria.range}}
					<label class="criteria-option">
						<input type="checkbox" name="exclude-range" value="{{this}}" />
						<span>{{this}}</span>
					</label>
				{{/each}}
			</div>
		</div>

		<!-- Exclude Traits -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.EXCLUDETRAITS"}}</h5>
			<div id="exclude-traits" class="criteria-options">
				{{#each criteria.traits}}
					<label class="criteria-option">
						<input type="checkbox" name="exclude-traits" value="{{this}}" />
						<span>{{this}}</span>
					</label>
				{{/each}}
			</div>
		</div>
	</div>

	<hr />
</section>

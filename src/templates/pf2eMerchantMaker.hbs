<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="merchantMaker">
	<!-- Merchant Name -->
	<label for="merchantName">{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.MERCHANTNAME"}}</label>
	<input
		type="text"
		id="merchantName"
		name="merchantName"
		value=""
		placeholder="{{localize 'FVTT_PF2EMERCHANTMAKER.WINDOW.MERCHANTPLACEHOLDER'}}"
	/>

	<!-- Selection Tip -->
	<p>
		<em>{{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.CRITERIATIP"}}}</em>
	</p>

	<!-- Include Criteria -->
	<div class="criteria-row">
		<!-- Include Rarity -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.INCLUDERARITY"}}</h5>
			<div id="include-rarity" class="criteria-options">
				{{#each criteria.rarity}}
					<label class="criteria-option">
						<input type="checkbox" name="include-rarity" value="{{this}}" />
						<span>{{this}}</span>
					</label>
				{{/each}}
			</div>
		</div>

		<!-- Include Type -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.INCLUDETYPE"}}</h5>
			<div id="include-type" class="criteria-options">
				{{#each criteria.type}}
					<label class="criteria-option">
						<input type="checkbox" name="include-type" value="{{this}}" />
						<span>{{this}}</span>
					</label>
				{{/each}}
			</div>
		</div>

		<!-- Include Category -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.INCLUDECATEGORY"}}</h5>
			<div id="include-category" class="criteria-options">
				{{#each criteria.category}}
					<label class="criteria-option">
						<input type="checkbox" name="include-category" value="{{this}}" />
						<span>{{this}}</span>
					</label>
				{{/each}}
			</div>
		</div>

		<!-- Include Group -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.INCLUDEGROUP"}}</h5>
			<div id="include-group" class="criteria-options">
				{{#each criteria.group}}
					<label class="criteria-option">
						<input type="checkbox" name="include-group" value="{{this}}" />
						<span>{{this}}</span>
					</label>
				{{/each}}
			</div>
		</div>

		<!-- Include Level -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.INCLUDELEVEL"}}</h5>
			<div id="include-level" class="criteria-options">
				{{#each criteria.level}}
					<label class="criteria-option">
						<input type="checkbox" name="include-level" value="{{this}}" />
						<span>{{this}}</span>
					</label>
				{{/each}}
			</div>
		</div>

		<!-- Include Range -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.INCLUDERANGE"}}</h5>
			<div id="include-range" class="criteria-options">
				{{#each criteria.range}}
					<label class="criteria-option">
						<input type="checkbox" name="include-range" value="{{this}}" />
						<span>{{this}}</span>
					</label>
				{{/each}}
			</div>
		</div>

		<!-- Include Traits -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.INCLUDETRAITS"}}</h5>
			<div id="include-traits" class="criteria-options">
				{{#each criteria.traits}}
					<label class="criteria-option">
						<input type="checkbox" name="include-traits" value="{{this}}" />
						<span>{{this}}</span>
					</label>
				{{/each}}
			</div>
		</div>
	</div>

	<hr />

	<!-- Exclude Criteria -->
	<div class="criteria-row">
		<!-- Exclude Rarity -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.EXCLUDERARITY"}}</h5>
			<div id="exclude-rarity" class="criteria-options">
				{{#each criteria.rarity}}

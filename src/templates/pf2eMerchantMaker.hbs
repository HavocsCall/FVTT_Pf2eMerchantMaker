<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="merchantMaker">
	<!-- Merchant Name -->
	<label for="merchantName">{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.MERCHANTNAME"}}</label>
	<input
		type="text"
		id="merchantName"
		name="merchantName"
		value=""
		placeholder="{{localize 'FVTT_PF2EMERCHANTMAKER.WINDOW.MERCHANTPLACEHOLDER'}}"
	/>

	<!-- Selection Tip -->
	<p>
		<em>{{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.CRITERIATIP"}}}</em>
	</p>

	<!-- Include Criteria -->
	<div class="criteria-row">
		{{#each includeCriteriaFields}}
			<div class="criteria-block">
				<h5>{{localize includeLabel}}</h5>
				<div id="{{id}}" class="criteria-options">
					{{#if isRange}}
						<div class="range-group">
							<label class="criteria-option">
								<input type="checkbox" name="{{rangeKindInputName}}" value="melee" />
								<span>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.MELEE"}}</span>
							</label>
							<div class="range-ranged-group">
								<label class="criteria-option">
									<input type="checkbox" name="{{rangeKindInputName}}" value="ranged" />
									<span>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.RANGED"}}</span>
									<span class="range-disclosure" aria-hidden="true"></span>
								</label>
								<div class="range-suboptions">
									{{#each rangeOptions}}
										<label class="criteria-option">
											<input type="checkbox" name="{{inputName}}" value="{{value}}" />
											<span>{{label}}</span>
										</label>
									{{/each}}
								</div>
							</div>
						</div>
					{{else}}
						{{#each options}}
							<label class="criteria-option">
								<input type="checkbox" name="{{inputName}}" value="{{value}}" />
								<span>{{label}}</span>
							</label>
						{{/each}}
					{{/if}}
				</div>
			</div>
		{{/each}}
	</div>

	<hr />

	<!-- Exclude Criteria -->
	<div class="criteria-row">
		{{#each excludeCriteriaFields}}
			<div class="criteria-block">
				<h5>{{localize excludeLabel}}</h5>
				<div id="{{id}}" class="criteria-options">
					{{#if isRange}}
						<div class="range-group">
							<label class="criteria-option">
								<input type="checkbox" name="{{rangeKindInputName}}" value="melee" />
								<span>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.MELEE"}}</span>
							</label>
							<div class="range-ranged-group">
								<label class="criteria-option">
									<input type="checkbox" name="{{rangeKindInputName}}" value="ranged" />
									<span>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.RANGED"}}</span>
									<span class="range-disclosure" aria-hidden="true"></span>
								</label>
								<div class="range-suboptions">
									{{#each rangeOptions}}
										<label class="criteria-option">
											<input type="checkbox" name="{{inputName}}" value="{{value}}" />
											<span>{{label}}</span>
										</label>
									{{/each}}
								</div>
							</div>
						</div>
					{{else}}
						{{#each options}}
							<label class="criteria-option">
								<input type="checkbox" name="{{inputName}}" value="{{value}}" />
								<span>{{label}}</span>
							</label>
						{{/each}}
					{{/if}}
				</div>
			</div>
		{{/each}}
	</div>

	<hr />
</section>
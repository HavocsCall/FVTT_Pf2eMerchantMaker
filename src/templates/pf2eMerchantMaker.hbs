<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="merchantMaker">
	<!-- Merchant Name -->
	<label for="merchantName">{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.MERCHANTNAME"}}</label>
	<input
		type="text"
		id="merchantName"
		name="merchantName"
		value=""
		placeholder="{{localize 'FVTT_PF2EMERCHANTMAKER.WINDOW.MERCHANTPLACEHOLDER'}}"
	/>

	<!-- Selection Tip -->
	<p>
		<em>{{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.CRITERIATIP"}}}</em>
	</p>

	<!-- Include Criteria -->
	<div class="criteria-row">
		<!-- Include Rarity -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.INCLUDERARITY"}}</h5>
			<select name="include-rarity" id="include-rarity" multiple class="highlight-select">
				{{#each criteria.rarity}}
					<option value="{{this}}">{{this}}</option>
				{{/each}}
			</select>
		</div>

		<!-- Include Type -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.INCLUDETYPE"}}</h5>
			<select name="include-type" id="include-type" multiple class="highlight-select">
				{{#each criteria.type}}
					<option value="{{this}}">{{this}}</option>
				{{/each}}
			</select>
		</div>

		<!-- Include Category -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.INCLUDECATEGORY"}}</h5>
			<select name="include-category" id="include-category" multiple class="highlight-select">
				{{#each criteria.category}}
					<option value="{{this}}">{{this}}</option>
				{{/each}}
			</select>
		</div>

		<!-- Include Group -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.INCLUDEGROUP"}}</h5>
			<select name="include-group" id="include-group" multiple class="highlight-select">
				{{#each criteria.group}}
					<option value="{{this}}">{{this}}</option>
				{{/each}}
			</select>
		</div>

		<!-- Include Level -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.INCLUDELEVEL"}}</h5>
			<select name="include-level" id="include-level" multiple class="highlight-select">
				{{#each criteria.level}}
					<option value="{{this}}">{{this}}</option>
				{{/each}}
			</select>
		</div>

		<!-- Include Range -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.INCLUDERANGE"}}</h5>
			<select name="include-range" id="include-range" multiple class="highlight-select">
				{{#each criteria.range}}
					<option value="{{this}}">{{this}}</option>
				{{/each}}
			</select>
		</div>

		<!-- Include Traits -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.INCLUDETRAITS"}}</h5>
			<select name="include-traits" id="include-traits" multiple class="highlight-select">
				{{#each criteria.traits}}
					<option value="{{this}}">{{this}}</option>
				{{/each}}
			</select>
		</div>
	</div>

	<hr />

	<!-- Exclude Criteria -->
	<div class="criteria-row">
		<!-- Exclude Rarity -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.EXCLUDERARITY"}}</h5>
			<select name="exclude-rarity" id="exclude-rarity" multiple class="highlight-select">
				{{#each criteria.rarity}}
					<option value="{{this}}">{{this}}</option>
				{{/each}}
			</select>
		</div>

		<!-- Exclude Type -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.EXCLUDETYPE"}}</h5>
			<select name="exclude-type" id="exclude-type" multiple class="highlight-select">
				{{#each criteria.type}}
					<option value="{{this}}">{{this}}</option>
				{{/each}}
			</select>
		</div>

		<!-- Exclude Category -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.EXCLUDECATEGORY"}}</h5>
			<select name="exclude-category" id="exclude-category" multiple class="highlight-select">
				{{#each criteria.category}}
					<option value="{{this}}">{{this}}</option>
				{{/each}}
			</select>
		</div>

		<!-- Exclude Group -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.EXCLUDEGROUP"}}</h5>
			<select name="exclude-group" id="exclude-group" multiple class="highlight-select">
				{{#each criteria.group}}
					<option value="{{this}}">{{this}}</option>
				{{/each}}
			</select>
		</div>

		<!-- Exclude Level -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.EXCLUDELEVEL"}}</h5>
			<select name="exclude-level" id="exclude-level" multiple class="highlight-select">
				{{#each criteria.level}}
					<option value="{{this}}">{{this}}</option>
				{{/each}}
			</select>
		</div>

		<!-- Exclude Range -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.EXCLUDERANGE"}}</h5>
			<select name="exclude-range" id="exclude-range" multiple class="highlight-select">
				{{#each criteria.range}}
					<option value="{{this}}">{{this}}</option>
				{{/each}}
			</select>
		</div>

		<!-- Exclude Traits -->
		<div class="criteria-block">
			<h5>{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.EXCLUDETRAITS"}}</h5>
			<select name="exclude-traits" id="exclude-traits" multiple class="highlight-select">
				{{#each criteria.traits}}
					<option value="{{this}}">{{this}}</option>
				{{/each}}
			</select>
		</div>
	</div>

	<hr />
</section>

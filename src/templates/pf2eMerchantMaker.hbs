<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="merchantMaker">
	<!-- Merchant Name -->
	<label for="merchantName">{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.MERCHANTNAME"}}</label>
	<input
		type="text"
		id="merchantName"
		name="merchantName"
		value=""
		placeholder="{{localize 'FVTT_PF2EMERCHANTMAKER.WINDOW.MERCHANTPLACEHOLDER'}}"
	/>

	<!-- Selection Tip -->
	<p>
		<em>{{{localize "FVTT_PF2EMERCHANTMAKER.WINDOW.CRITERIATIP"}}}</em>
	</p>

	<!-- Include Criteria -->
	<div class="criteria-row">
		{{#each criteriaFields}}
			<div class="criteria-block">
				<h5>{{localize includeLabel}}</h5>
				<div id="include-{{key}}" class="criteria-options">
					{{#each (lookup ../criteria key)}}
						<label class="criteria-option">
							<input type="checkbox" name="include-{{../key}}" value="{{this}}" />
							<span>{{this}}</span>
						</label>
					{{/each}}
				</div>
			</div>
		{{/each}}
	</div>

	<hr />

	<!-- Exclude Criteria -->
	<div class="criteria-row">
		{{#each criteriaFields}}
			<div class="criteria-block">
				<h5>{{localize excludeLabel}}</h5>
				<div id="exclude-{{key}}" class="criteria-options">
					{{#each (lookup ../criteria key)}}
						<label class="criteria-option">
							<input type="checkbox" name="exclude-{{../key}}" value="{{this}}" />
							<span>{{this}}</span>
						</label>
					{{/each}}
				</div>
			</div>
		{{/each}}
	</div>

	<hr />
</section>
